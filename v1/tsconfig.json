{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.cts"
  ],
  "exclude": [
    ".dev",
    "node_modules",
    "test/.artifacts"
  ]
}
