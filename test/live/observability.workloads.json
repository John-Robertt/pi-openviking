{
  "schemaVersion": 1,
  "gate": "verify:observability:live",
  "purpose": "在真实 Pi lifecycle、真实同步、受支持 OpenViking 以及受控断线、URI 拒绝和 409 冲突上，证明统一观察 run 完整、安全、只观察且能够复原当前全链路。",
  "identities": {
    "pi": {
      "package": "@earendil-works/pi-coding-agent",
      "version": "0.84.2",
      "binPath": "node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
    },
    "node": { "engines": ">=22.19.0" },
    "openviking": {
      "version": "0.4.15",
      "endpoint": "http://127.0.0.1:19331",
      "authMode": "dev",
      "account": "dev",
      "user": "dev"
    },
    "modelProfile": {
      "path": "dev/model-profile.json",
      "sha256": "38f28aed9d6ec9a129d9c554a85e47ef316ae226897e066bc9324f05f29ab246"
    },
    "registry": {
      "schemaVersion": 1,
      "sha256": "fc7df5a04166218e1e9a3601909815e49d6034c59280760b579d01c868a8913d"
    },
    "extensionLoadOrder": ["index.ts"]
  },
  "environment": {
    "observationSink": "父进程以 wx/0600 预开空常规文件并作为 FD 3 继承；子进程仅接收 OV_OBSERVE_FD=3，不接触 artifact 路径",
    "isolation": "HOME、PI_CODING_AGENT_DIR、session 与 observation artifact 全部位于 test/.artifacts/live/<runId>",
    "credentials": "任务模型 key 由 verifier 按 taskModel 身份桥接给真实 Pi；VLM key 只由受管 OpenViking 启动路径持有；两者均不写入 manifest、observation、session、summary 或日志"
  },
  "workloads": [
    {
      "id": "success-recall-sync",
      "summary": "随机 session namespace 异步写入所属 marker 与 resource，并在统一 deadline 内轮询真实 search 直到目标 URI 可检索；真实 Pi prompt 触发 recall 产品 entry，再由 /viking sync 证明 Content 写入和 ACK 推进。",
      "prompt": "请只回复 OK 两个字母，不要调用任何工具。",
      "expectedRecords": [
        { "stage": "pi_lifecycle", "data": { "phase": "end", "hook": "session_shutdown", "outcome": "success" } },
        { "stage": "pi_entry_append", "data": { "phase": "end", "operation": "recall_injection", "outcome": "appended" } },
        { "stage": "memory_namespace", "data": { "branch": "session" } },
        { "stage": "sync_schedule", "data": { "branch": "sync" } },
        { "stage": "profile_result", "data": { "branch": "omit" } },
        { "stage": "client_http", "data": { "phase": "end", "outcome": "success" } },
        { "stage": "client_connection", "data": { "mode": "change", "to": true } },
        { "stage": "client_namespace", "data": { "mode": "change", "bound": true } },
        { "stage": "sync_source", "data": { "branch": "persistent_jsonl" } },
        { "stage": "shutdown_grace", "data": { "branch": "drained" } },
        { "stage": "sync_capability", "data": { "mode": "change", "to": "ready" } },
        { "stage": "sync_ack", "data": { "mode": "change" } },
        { "stage": "sync_ack_advance", "data": { "branch": "advance", "capabilityVerified": true } },
        { "stage": "event_representation", "data": { "branch": "direct" } },
        { "stage": "archive_plan", "data": { "branch": "idle", "planned": 0 } },
        { "stage": "archive_state", "data": { "mode": "snapshot", "committed": 0, "current": null } },
        { "stage": "active_context_select", "data": { "branch": "unavailable" } },
        { "stage": "active_context_eligibility", "data": { "branch": "no_context" } },
        { "stage": "active_context_state", "data": { "mode": "snapshot", "status": "no_context", "checkpoint": null } },
        { "stage": "active_context_takeover", "data": { "branch": "keep_full_context" } },
        { "stage": "checkpoint_state", "data": { "mode": "snapshot", "status": "caught_up" } },
        { "stage": "recall_request", "data": { "branch": "search" } },
        { "stage": "recall_source", "data": { "branch": "context_face" } },
        { "stage": "recall_result", "data": { "operation": "inject", "branch": "injected" } }
      ],
      "successCriteria": [
        "异步 fixture 只有在真实 search 返回同一 resource URI 后才就绪；文件存在、错误类型或其他 URI 均不能通过",
        "Pi exitCode=0、extension_error=0、/viking sync notify=info",
        "observation run 完整、seq 连续、boundary op 全部配对、accepted=end.seq、dropped=0",
        "recall 注入通过 pi_entry_append 记录且观察 artifact 不含 recall 内容、prompt、session/user/URI、凭证",
        "ACK frontier 推进且观察记录未进入 Pi JSONL 或 OpenViking event namespace"
      ],
      "falsification": [
        "fixture 在 deadline 内未被真实 search 命中，或命中来源不是目标 resource URI",
        "任一 expected stage 缺失或出现未配对 boundary",
        "观察 sink 改变 Pi 返回、ACK、HTTP 顺序或 shutdown 结果",
        "原始敏感值出现在观察 artifact、summary 或错误诊断"
      ]
    },
    {
      "id": "disconnect-fail-open",
      "summary": "真实 Pi 使用固定死端口完成 prompt，事件保持待重放且观察完整记录 network_error、未连接状态与 observe 分派。",
      "endpoint": "http://127.0.0.1:9",
      "remoteOwnership": false,
      "prompt": "请只回复 OK 两个字母，不要调用任何工具。",
      "expectedRecords": [
        { "stage": "pi_lifecycle", "data": { "phase": "end", "hook": "session_shutdown", "outcome": "success" } },
        { "stage": "memory_namespace", "data": { "branch": "session" } },
        { "stage": "sync_schedule", "data": { "branch": "observe", "connected": false } },
        { "stage": "profile_result", "data": { "branch": "omit" } },
        { "stage": "client_http", "data": { "phase": "end", "outcome": "network_error" } },
        { "stage": "client_connection", "data": { "mode": "snapshot", "current": false } },
        { "stage": "client_namespace", "data": { "mode": "change", "bound": true } },
        { "stage": "sync_source", "data": { "branch": "persistent_jsonl" } },
        { "stage": "shutdown_grace", "data": { "branch": "drained" } },
        { "stage": "sync_capability", "data": { "mode": "snapshot", "current": "unknown" } },
        { "stage": "sync_ack", "data": { "mode": "snapshot" } },
        { "stage": "active_context_takeover", "data": { "branch": "keep_full_context" } }
      ],
      "successCriteria": [
        "Pi exitCode=0 且 agent_settled 到达，观察 run 完整",
        "至少一个 client_http:network_error，sync_schedule 分支为 observe，ACK 不推进",
        "产品 session JSONL 保留输入/输出且不包含 observation record"
      ],
      "falsification": [
        "断线使 Pi 主任务失败或观察 run 缺少 end",
        "断线期间 ACK 推进或产生远端 namespace"
      ]
    },
    {
      "id": "conflict-409",
      "summary": "先在死端口真实 Pi run 形成待同步 entry，再在所属随机 namespace 注入不同字节；真实端点重放得到 409、保持 ACK 且不覆盖冲突对象。",
      "prompt": "请只回复 OK 两个字母，不要调用任何工具。",
      "expectedRecords": [
        { "stage": "pi_lifecycle", "data": { "phase": "end", "hook": "session_shutdown", "outcome": "success" } },
        { "stage": "memory_namespace", "data": { "branch": "session" } },
        { "stage": "sync_schedule", "data": { "branch": "sync", "connected": true } },
        { "stage": "profile_result", "data": { "branch": "omit" } },
        { "stage": "client_http", "data": { "phase": "end", "outcome": "http_error", "status": 409 } },
        { "stage": "client_connection", "data": { "mode": "change", "to": true } },
        { "stage": "client_namespace", "data": { "mode": "change", "bound": true } },
        { "stage": "sync_source", "data": { "branch": "persistent_jsonl" } },
        { "stage": "shutdown_grace", "data": { "branch": "drained" } },
        { "stage": "sync_capability", "data": { "mode": "snapshot" } },
        { "stage": "sync_ack", "data": { "mode": "snapshot" } },
        { "stage": "sync_failure", "data": { "errorClass": "integrity", "errorCode": "delivery", "disposition": "abort_operation", "branch": "pending_replay" } },
        { "stage": "event_representation", "data": { "branch": "direct" } }
      ],
      "successCriteria": [
        "冲突同步 Pi exitCode=0、/viking sync notify=warning、ACK 不越过冲突 entry",
        "client_http 出现 409/http_error，sync_failure 为 integrity/pending_replay，观察 run 完整",
        "冲突对象字节保持 verifier 注入值且所属 namespace 安全清理"
      ],
      "falsification": [
        "冲突对象被覆盖或 ACK 推进",
        "同一次错误处置被 adapter、client、sync 多个责任模块重复记录为 failure"
      ]
    },
    {
      "id": "tool-uri-rejection",
      "summary": "确定性脚本 provider 依次驱动真实 Pi 调用越界 read、删除内部事实及导入 HTTP Resource；默认会话隔离下三个操作均在各自生产边界拒绝，显式 /viking sync 收敛运行事件证据。",
      "driver": "scripted-provider",
      "prompt": "读取那个文件，然后只回复 DONE。",
      "expectedRecords": [
        { "stage": "pi_lifecycle", "data": { "phase": "end", "hook": "session_shutdown", "outcome": "success" } },
        { "stage": "tool_uri_guard", "data": { "tool": "read", "branch": "block" } },
        { "stage": "tool_scope", "data": { "tool": "viking_forget", "operation": "delete", "scoped": true, "branch": "deny", "accepted": 0, "rejected": 1 } },
        { "stage": "tool_scope", "data": { "tool": "viking_add_resource", "operation": "resource_add", "scoped": true, "branch": "deny", "accepted": 0, "rejected": 1 } },
        { "stage": "tool_availability", "data": { "branch": "proceed" } }
      ],
      "successCriteria": [
        "真实 Pi tool_execution_end 证明 read、viking_forget 与会话隔离下的 viking_add_resource 均被拒绝",
        "拒绝点之后没有 OpenViking content/read、DELETE 或全局 Resource 导入请求",
        "显式同步后观察 run 完整、全部源事件已确认，且 artifact 不含 URI、prompt、session/user 或工具返回内容"
      ],
      "falsification": [
        "脚本输入未触发三个工具调用，或任一拒绝边界未生效",
        "拒绝后发出 OpenViking content/read、DELETE 或 /resources 请求",
        "URI、prompt 或工具返回出现在观察 artifact"
      ]
    }
  ],
  "deterministicStages": [
    "index_failure",
    "archive_commit",
    "archive_failure",
    "checkpoint_request",
    "checkpoint_process",
    "checkpoint_failure",
    "active_context_compaction",
    "active_context_failure",
    "recall_failure"
  ],
  "globalAssertions": [
    "manifest hash、registry hash/active stage 全集、Pi/OpenViking/model profile 身份以及运行中 ov.conf/状态指纹/profile 生成配置全部匹配后才运行 workload",
    "每个观察 artifact 由父进程 fsync/close 后读取；完整性、原始 hash、stage/outcome 计数写入白名单 summary",
    "远端只使用随机 session namespace；写入前必须不存在，marker 逐字节回读；删除前逐字节复核 marker 与写入一致，按构造的精确根路径删除",
    "删除后等待 cleanupSettleMs 越过 0.4.15 目录语义物化窗口，全部已写对象必须持续不存在；服务重建的无文件 namespace 骨架仅记录，不伪报为产品数据残留",
    "passed 删除整个本地 run 目录；failed 删除 session JSONL 与 raw provider payload，观察 JSONL 作为字段白名单脱敏诊断与 summary、ownership marker 一并保留"
  ],
  "thresholds": {
    "piRunWallMs": 120000,
    "agentSettledMs": 90000,
    "syncNotifyMs": 90000,
    "fixtureMs": 360000,
    "fixturePollMs": 1000,
    "cleanupSettleMs": 60000,
    "baseline": {
      "measuredAt": "2026-08-21T00:55:00.000Z",
      "expected": {
        "disabled": "deterministic baseline 的产品返回值、状态与调用顺序不变，观察依赖调用为 0",
        "enabled": "每个 run 完整、dropped=0，产品成功/ACK/fail-open/权限结果与对应 workload 断言一致"
      },
      "runs": [
        { "workload": "success-recall-sync", "label": "success", "observedMs": 4374, "observedRecords": 136, "maxMs": 90000, "minRecords": 100, "maxRecords": 512 },
        { "workload": "disconnect-fail-open", "label": "disconnect", "observedMs": 3008, "observedRecords": 39, "maxMs": 30000, "minRecords": 20, "maxRecords": 128 },
        { "workload": "conflict-409", "label": "conflict-prep", "observedMs": 3733, "observedRecords": 39, "maxMs": 30000, "minRecords": 20, "maxRecords": 128 },
        { "workload": "conflict-409", "label": "conflict-sync", "observedMs": 454, "observedRecords": 72, "maxMs": 30000, "minRecords": 30, "maxRecords": 256 },
        { "workload": "tool-uri-rejection", "label": "tool-uri-live", "observedMs": 777, "observedRecords": 228, "maxMs": 90000, "minRecords": 20, "maxRecords": 256 }
      ]
    }
  }
}
