{
  "name": "pi-openviking",
  "version": "0.3.7",
  "description": "Pi extension for append-only OpenViking event recording, reliable replay, and memory recall.",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "bin": {
    "pi-openviking": "scripts/cli.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "dev": "node scripts/dev.mjs",
    "verify:phase0:live": "node test/live/phase0-live.mjs",
    "verify:observability:live": "node test/live/observability-live.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2",
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "typebox": ">=1.3.14"
  },
  "files": [
    "*.ts",
    "config.json",
    "lib/",
    "shared/",
    "scripts/cli.mjs",
    "README.md",
    "AGENTS.md",
    "docs/spec.md",
    "docs/roadmap.md",
    "docs/verification.md",
    "docs/observability.md",
    "docs/design.md",
    "docs/development.md",
    "docs/usage.md"
  ],
  "dependencies": {
    "undici": "^7"
  }
}
