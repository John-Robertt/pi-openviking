{
  "name": "pi-echo",
  "version": "0.5.0",
  "description": "Pi extension that provides scoped memory cues and full-fact recall across compaction and branch changes.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run typecheck && node --test \"test/modules/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:pi": "npm run typecheck && node --test \"test/pi/**/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
